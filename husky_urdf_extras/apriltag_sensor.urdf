<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <link name="apriltag_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/> 
      <geometry>
        <mesh filename="package://lar_gazebo/models/tag36_11_00000/meshes/tag36_11_00000.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.15 0.15 0.005"/>
      </geometry>
    </collision>
    
    <inertial>
      <mass value="0.01"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="husky_to_apriltag" type="fixed">
    <parent link="top_plate_link"/>
    <child link="apriltag_link"/>
    <origin xyz="0 0 0.0" rpy="0 0 0"/>
  </joint>

</robot>